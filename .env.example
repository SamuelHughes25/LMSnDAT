DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
# Django is NEVER reached over the public domain directly — only Next.js
# sits behind Caddy on the public internet; Django only ever receives
# requests from the `frontend` container over the internal Docker network
# (see docs/PROJECT_LOG.md's BFF decision). So ALLOWED_HOSTS stays these
# internal names in production too, same as dev — the real domain never
# needs to appear here.
ALLOWED_HOSTS=localhost,127.0.0.1,web
TIME_ZONE=UTC

DATABASE_URL=postgres://lms:lms@db:5432/lms
REDIS_URL=redis://redis:6379/0

# STORAGE_BACKEND=local (default, filesystem) or s3 (DigitalOcean Spaces / any S3-compatible)
STORAGE_BACKEND=local
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET_NAME=
SPACES_ENDPOINT_URL=
SPACES_REGION=

# --- Production only (docker-compose.prod.yml) ---
# Uncomment and fill these in on the Droplet's own .env — never commit real
# values. DJANGO_SECRET_KEY above must also be replaced with a real generated
# value (see README.md's production section for how), and DATABASE_URL's
# password must match POSTGRES_PASSWORD below exactly (two places read the
# same credential — docker-compose.prod.yml's `db` service sets the real
# Postgres password from POSTGRES_PASSWORD; Django connects to it via
# DATABASE_URL — change one, change both, same "stays in sync manually"
# relationship dev's DATABASE_URL already has with dev compose's hardcoded
# POSTGRES_PASSWORD: lms).
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=False
# Leave SECURE_SSL_REDIRECT/SESSION_COOKIE_SECURE/CSRF_COOKIE_SECURE unset
# (all default False) — Django is internal-only here (see settings/
# production.py's own comment for the full why); Caddy already handles real
# HTTPS for the public domain. Setting SECURE_SSL_REDIRECT=True broke the
# entire site on the first real deploy (every internal Next.js->Django call
# got redirected to an https://web:8000/... gunicorn can't serve).
#
# DATABASE_URL=postgres://lms:REPLACE_ME@db:5432/lms
# POSTGRES_DB=lms
# POSTGRES_USER=lms
# POSTGRES_PASSWORD=REPLACE_ME
#
# The domain Caddy requests/serves a cert for (see ./Caddyfile) — also where
# the frontend container's own public-facing cookies/URLs point. Required —
# docker-compose.prod.yml refuses to start the `caddy` service without it.
# DOMAIN=yourdomain.com
#
# Sentry — leave both blank to disable entirely (see settings/base.py's own
# comment: genuinely never initializes sentry_sdk when SENTRY_DSN is unset).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
#
# Same Sentry project, read by the Next.js build/runtime instead of Django —
# see frontend/src's own Sentry config files for how this is consumed. Also
# passed to docker-compose.prod.yml's `frontend` service directly (it needs
# this at runtime, not just build time, since instrumentation-client.ts reads
# it in the browser).
# NEXT_PUBLIC_SENTRY_DSN=
